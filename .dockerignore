# Git
.git
.gitignore
.gitattributes

# Dependencies — reinstalled fresh inside Docker
node_modules
packages/*/node_modules

# Yarn PnP / cache — not needed, Docker installs from scratch
.yarn/cache
.yarn/unplugged
.pnp.cjs
.pnp.loader.mjs

# Build outputs — rebuilt inside Docker
packages/*/dist
packages/web/build

# Environment files — injected at runtime via docker-compose env_file
.env
.env.*
!.env.example

# Test files — not needed in production images
coverage
packages/*/coverage
**/*.spec.ts
**/*.test.ts
**/test/
**/e2e/

# Docs and IDE config — not needed in images
docs
README.md
.vscode
.idea
*.iml
.editorconfig

# OS artifacts
.DS_Store
Thumbs.db
